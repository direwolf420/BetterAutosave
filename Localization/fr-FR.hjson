Mods: {
	BetterAutosave: {
		Configs: {
			AServerConfig: {
				DisplayName: Configuration Serveur+Solo

				AutosaveInterval: {
					Label: Intervalle de la Sauvegarde automatique
					Tooltip: Intervalle de la Sauvegarde automatique en secondes
				}

				AutosaveDisabled: {
					Label: Désactiver la Sauvegarde automatique
					Tooltip: Activez si vous voulez entièrement désactiver la sauvegarde automatique
				}

				Notify: {
					Label: Messages de Notification
					Tooltip: Activez si vous voulez recevoir un message lors d'une sauvegarde (console du serveur ou chat)
				}

				Headers.ServerSingleplayerConfigInfo:
					'''
					==Info de Configuration Serveur+Solo==
					Sauvegardera le monde et le joueur en mode Solo,
					et seulement le monde en mode multijoueur
					'''

				AutosaveStatus: {
					Label: Sauvegarde automatique activée
					Tooltip: Ce mod fonctionnera toujours s'il est activé sur le serveur. En solo, seulement si la 'Sauvegarde automatique' est activée dans la configuration.
				}

				CurrentInterval: {
					Label: Intervalle Actuel (heure:minutes:secondes)
					Tooltip: ""
				}
			}

			BClientConfig: {
				DisplayName: Configuration du Client Multijoueur

				AutosaveInterval: {
					Label: Intervalle de la Sauvegarde automatique
					Tooltip: Intervalle de la Sauvegarde automatique en secondes
				}

				AutosaveDisabled: {
					Label: Désactiver la Sauvegarde automatique
					Tooltip: Activez si vous voulez empêcher la sauvegarde automatique
				}

				Notify: {
					Label: Messages de Notification
					Tooltip: Activez si vous voulez recevoir un message lors d'une sauvegarde (console du serveur ou chat)
				}

				Headers.MultiplayerClientConfigInfo:
					'''
					==Info de Configuration du Client Multijoueur==
					Sauvegardera le joueur seulement en mode multijoueur
					'''

				AutosaveStatus: {
					Label: Sauvegarde automatique activée
					Tooltip: La sauvegarde automatique fonctionnera toujours en multijoueur pour le client
				}

				CurrentInterval: {
					Label: Intervalle Actuel (heure:minutes:secondes)
					Tooltip: ""
				}
			}
		}

		Common: {
			AutosavedWorld: Le Monde a été Sauvegardé automatiquement
			AutosavedPlayer: Le Joueur a été Sauvegardé automatiquement
			AutosavedWorldPlayer: Le Monde et Le Joueur ont été Sauvegardés automatiquement
		}
	}
}
