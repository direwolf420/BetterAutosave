Mods: {
	BetterAutosave: {
		Configs: {
			AServerConfig: {
				DisplayName: Configuration de Serveur+Un joueur

				AutosaveInterval: {
					Label: Intervalle de Sauvegarde automatique
					Tooltip: Intervalle de Sauvegarde auto en seconde
				}

				AutosaveDisabled: {
					Label: Désactiver la Sauvegarde automatique
					Tooltip: Activez si vous voulez désactiver la sauvegarde automatique
				}

				Notify: {
					Label: Message des Notifications
					Tooltip: Activez si vous voulez recevoir un Message lors d'une sauvegarde (console de serveur ou chat)
				}

				Headers.ServerSingleplayerConfigInfo:
					'''
					==Info de Config de Serveur+Un joueur==
					Sauvegardera le Monde et le Joueur en mode Solo,
					et seulement le Monde en mode Multijoueur
					'''

				AutosaveStatus: {
					Label: Sauvegarde auto active
					Tooltip: Ce mod fonctionnera toujours s'il est activé sur le Serveur. Dans solo, seulement si 'Sauvegarde auto' est active dans le Config.
				}

				CurrentInterval: {
					Label: Intervalle Actuel (heure:minutes:secondes)
					Tooltip: ""
				}
			}

			BClientConfig: {
				DisplayName: Configuration du Client Multijoueur

				AutosaveInterval: {
					Label: Intervalle de Sauvegarde automatique
					Tooltip: Intervalle de Sauvegarde auto en seconde
				}

				AutosaveDisabled: {
					Label: Désactiver la Sauvegarde automatique
					Tooltip: Activez si vous voulez empêcher la sauvegarde automatique
				}

				Notify: {
					Label: Message des Notifications
					Tooltip: Activez si vous voulez recevoir un Message lors d'une sauvegarde (console de serveur ou chat)
				}

				Headers.MultiplayerClientConfigInfo:
					'''
					==Info de Configuration du Client Multijoueur==
					Sauvegardera le joueur seulement dans Mode Multijoueur.
					'''

				AutosaveStatus: {
					Label: Sauvegarde auto active
					Tooltip: Sauvegarde fonctionnera toujours en Multijoueur pour le Client
				}

				CurrentInterval: {
					Label: Intervalle Actuel (heure:minutes:secondes)
					Tooltip: ""
				}
			}
		}

		Common: {
			AutosavedWorld: Le Monde a été Auto-Sauvegardé
			AutosavedPlayer: Le Joueur a été Auto-Sauvegardé
			AutosavedWorldPlayer: Le Monde et Le Joueur ont été Auto-Sauvegardé
		}
	}
}
